---
import BaseHead from '../components/BaseHead.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { about, education, experience, honors, profile, works } from '../data/profile';
import '../styles/home.css';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="page">
			<Sidebar />

			<main>
				<!-- 关于我 -->
				<section class="section" id="about">
					<p class="eyebrow">{about.label}</p>
					<h2 class="headline">
						<span>{about.headlineTop}</span>
						<span>{about.headlineBottom}</span>
					</h2>
					<div class="about-text">
						{about.paragraphs.map((p) => <p>{p}</p>)}
					</div>
					{
						about.tags.length > 0 && (
							<ul class="tags">
								{about.tags.map((t) => (
									<li>{t}</li>
								))}
							</ul>
						)
					}
				</section>

				<!-- 研究与作品 -->
				<section class="section" id="works">
					<div class="section-head">
						<h2 class="section-title">{works.label}</h2>
						<span class="section-meta">{works.meta}</span>
					</div>
					{
						works.items.map((w, i) => (
							<article class="work">
								<div class="work-top">
									<span>
										<span class="work-index">{String(i + 1).padStart(2, '0')}</span> / {w.category}
									</span>
									<span>{w.venue}</span>
								</div>
								<h3 class="work-title">{w.title}</h3>
								<p class="work-subtitle">{w.subtitle}</p>
								<p class="work-byline">{w.byline}</p>
								<p class="work-desc">{w.description}</p>
								{w.note && <p class="work-note">{w.note}</p>}
								{w.links.length > 0 && (
									<div class="work-links">
										{w.links.map((l) => (
											<a href={l.href} target="_blank" rel="noopener">
												{l.label} ↗
											</a>
										))}
									</div>
								)}
							</article>
						))
					}
				</section>

				<!-- 经历 -->
				<section class="section" id="experience">
					<div class="section-head">
						<h2 class="section-title">{experience.label}</h2>
						<span class="section-meta">{experience.meta}</span>
					</div>
					{
						experience.items.map((e) => (
							<article class="exp">
								<div class="exp-period">{e.period}</div>
								<div>
									<p class="exp-org">
										{e.org}
										{e.current && <span class="badge">Current</span>}
									</p>
									<p class="exp-role">{e.role}</p>
									<p class="exp-desc">{e.desc}</p>
								</div>
							</article>
						))
					}
				</section>

				<!-- 教育与助教 -->
				<section class="section" id="education">
					<div class="section-head">
						<h2 class="section-title">{education.label}</h2>
						<span class="section-meta">{education.period}</span>
					</div>
					<p class="edu-school">{education.school}</p>
					<p class="edu-degree">{education.degree}</p>
					<p class="edu-line">{education.dept}</p>
					<p class="edu-meta">{education.meta}</p>

					{
						education.teaching.length > 0 && (
							<div class="teaching">
								<h3>{education.teachingLabel}</h3>
								<ul>
									{education.teaching.map((t) => (
										<li>
											{t.course}
											<span>{t.years}</span>
										</li>
									))}
								</ul>
							</div>
						)
					}
				</section>

				<!-- 荣誉与奖学金 -->
				<section class="section" id="honors">
					<div class="section-head">
						<h2 class="section-title">{honors.label}</h2>
						<span class="section-meta">{honors.meta}</span>
					</div>
					<ul class="honors">
						{
							honors.items.map((h) => (
								<li>
									<span class="year">{h.year}</span>
									<span class="title">
										{h.title}
										{h.titleCn && <small>{h.titleCn}</small>}
									</span>
								</li>
							))
						}
					</ul>
				</section>

				<footer class="page-footer">
					<span>© {year} {profile.nameEn}</span>
					<a href={`mailto:${profile.email}`}>{profile.email} ↗</a>
				</footer>
			</main>
		</div>
	</body>
</html>
