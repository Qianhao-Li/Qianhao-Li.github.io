---
import { Image } from 'astro:assets';
import Avatar from '../assets/avatar.jpg';
import { profile } from '../data/profile';
---

<aside class="sidebar">
	<Image src={Avatar} alt={profile.nameEn} width={360} height={360} class="avatar" />

	<h1 class="name">{profile.nameEn}</h1>
	{profile.nameCn && <p class="name-cn">{profile.nameCn}</p>}

	<p class="role">{profile.role}</p>
	<p class="affiliation">{profile.affiliation}</p>

	<a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>

	<nav class="icons" aria-label="链接">
		{
			profile.github && (
				<a href={profile.github} target="_blank" rel="noopener" title="GitHub">
					<span class="sr-only">GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						/>
					</svg>
				</a>
			)
		}
		{
			profile.scholar && (
				<a href={profile.scholar} target="_blank" rel="noopener" title="Google Scholar">
					<span class="sr-only">Google Scholar</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path fill="currentColor" d="M8 0 0 5.2l8 5.2 8-5.2L8 0zM3.2 8.1v3.3c0 1.6 2.1 2.9 4.8 2.9s4.8-1.3 4.8-2.9V8.1L8 11.3 3.2 8.1z" />
					</svg>
				</a>
			)
		}
		{
			profile.twitter && (
				<a href={profile.twitter} target="_blank" rel="noopener" title="X">
					<span class="sr-only">X</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path fill="currentColor" d="M9.3 6.8 15 0h-1.4L8.7 5.9 4.8 0H0l6 8.9L0 16h1.4l5.2-6.2L10.8 16H16L9.3 6.8zm-1.8 2.2-.6-.9L1.9 1.1h2.2l3.9 5.6.6.9 5.1 7.3h-2.2L7.5 9z" />
					</svg>
				</a>
			)
		}
		<a href="/rss.xml" title="RSS">
			<span class="sr-only">RSS</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
				<path
					fill="currentColor"
					d="M2 2v2.5c5.246 0 9.5 4.254 9.5 9.5H14C14 7.373 8.627 2 2 2zm0 4.5V9c2.761 0 5 2.239 5 5h2.5C9.5 9.858 6.142 6.5 2 6.5zM3.5 11a1.75 1.75 0 1 0 0 3.5 1.75 1.75 0 0 0 0-3.5z"
				/>
			</svg>
		</a>
	</nav>

	<a class="blog-link" href="/blog">文章 / Blog →</a>
</aside>

<style>
	.sidebar {
		text-align: center;
	}

	.avatar {
		width: 180px;
		height: 180px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 30%;
		margin: 0 auto 1.5rem;
		display: block;
	}

	.name {
		font-family: var(--font-serif);
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.2;
		margin: 0;
		color: var(--ink);
	}

	.name-cn {
		font-size: 1rem;
		color: var(--ink-soft);
		margin: 0.3rem 0 0;
		letter-spacing: 0.08em;
	}

	.role,
	.affiliation {
		font-size: 0.875rem;
		color: var(--ink-mute);
		margin: 0;
		line-height: 1.6;
	}

	.role {
		margin-top: 1rem;
	}

	.email {
		display: inline-block;
		margin-top: 1rem;
		font-size: 0.8125rem;
		color: var(--accent);
		word-break: break-all;
		text-decoration: none;
	}

	.email:hover {
		text-decoration: underline;
	}

	.icons {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 1.1rem;
	}

	.icons a {
		color: var(--ink-mute);
		display: flex;
		transition: color 0.15s ease;
	}

	.icons a:hover {
		color: var(--accent);
	}

	.blog-link {
		display: inline-block;
		margin-top: 1.5rem;
		font-size: 0.8125rem;
		color: var(--ink-mute);
		text-decoration: none;
		border-bottom: 1px solid var(--rule);
		padding-bottom: 2px;
	}

	.blog-link:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	@media (max-width: 860px) {
		.avatar {
			width: 132px;
			height: 132px;
			margin-bottom: 1rem;
		}
		.name {
			font-size: 1.5rem;
		}
	}
</style>
